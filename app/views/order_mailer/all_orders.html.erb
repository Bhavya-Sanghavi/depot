<h1><%= t("order_mailer.all_orders.greeting", name: @user.name) %></h1>

<p><%= t("order_mailer.all_orders.summary") %></p>

<% @orders.each do |order| %>
  <h2>Order #<%= order.id %></h2>

  <p><%= t("order_mailer.all_orders.order_date") %><%= order.created_at %></p>

  <table>
    <%= render partial: "order_mailer/line_item", collection: order.line_items, as: :line_item %>
  </table>

  <p><%= t("order_mailer.all_orders.total") %><%= number_to_currency(order.line_items.sum(&:total_price)) %></p>

  <hr>
<% end %>