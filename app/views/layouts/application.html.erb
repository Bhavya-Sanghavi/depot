<!DOCTYPE html>
<html>
  <head>
    <title>Pragprog Books Online Store</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "line_items", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="bg-green-700">
      <aside data-controller="locale" class="absolute top-4 right-6 z-10">
        <%= form_tag store_index_path, class: "locale" do %>
          <%= select_tag "set_locale",
              options_for_select(LANGUAGES, I18n.locale.to_s),
              onchange: "this.form.submit()",
              class: "bg-white text-gray-800 border border-gray-300 rounded-md px-3 py-2 shadow-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-green-500" %>
          <%= submit_tag "submit", data: { "locale-target": "submit" } %>
        <% end %>
      </aside>
      <%= image_tag 'logo.svg', alt: 'The Pragmatic Bookshelf' %>
    </header>

    <section class="flex">
      <nav class="bg-green-900 p-6">
        <%= render partial: 'layouts/cart', locals: {cart: @cart} %>
        <ul class="text-gray-300 leading-8">
          <li><a href="/"><%= t('.home') %></a></li>
          <li><a href="/questions"><%= t('.questions') %></a></li>
          <li><a href="/news"><%= t('.news') %></a></li>
          <li><a href="/contact"><%= t('.contact') %></a></li>
        </ul>
        <% if session[:user_id] %>
          <hr class="my-2">

          <ul class="text-gray-300 leading-8">
            <li><%= link_to 'Orders',   orders_path   %></li>
            <li><%= link_to 'Products', products_path %></li>
            <li><%= link_to 'Users',    users_path    %></li>
            <li><%= button_to 'Logout', logout_path, method: :delete %></li>
          </ul>
        <% end %>
      </nav>

      <main class="container mx-auto mt-4 px-5 flex">
        <%= yield %>
      </main>
    </section>
  </body>
</html>
