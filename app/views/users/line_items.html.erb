<div class="flex flex-col gap-8">

  <h1 class="text-2xl mb-4">My Orders:</h1>

  <% if @total_count == 0 %>
    <p> No line items present. <p>
  <% end %>

  <% @line_items.each do |line_item| %>
    <div>
      <p>Product: <%= line_item.product.title %></p>
      <p>Quantity: <%= line_item.quantity %></p>
      <p>Created at: <%= line_item.created_at %></p>
    </div>
  <% end %>

  <% if @page > 1 %>
    <%= link_to "Previous", users_line_items_path(page: @page - 1), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <% end %>

  <% if @page < @total_pages %>
    <%= link_to "Next", users_line_items_path(page: @page + 1), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <% end %>

</div>
