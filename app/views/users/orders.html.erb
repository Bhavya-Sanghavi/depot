<div class="flex flex-col gap-8">

  <h1 class="text-2xl mb-4">My Orders:</h1>

  <% if @orders.count == 0 %>
    <p> No orders present. <p>
  <% end %>

  <% @orders.each do |order| %>
    <div>

      <h2>Order #<%= order.id %></h2>

      <p>Time: <%= order.created_at %></p>

      <h3>Line Items</h3>

      <% order.line_items.each do |line_item| %>
        <p>
          <%= line_item.product.title %> x <%= line_item.quantity %>
        </p>
      <% end %>

      <p>
        Total: <%= number_to_currency(order.line_items.sum { |item| item.quantity * item.product.price }) %>
      </p>

    </div>
  <% end %>

</div>