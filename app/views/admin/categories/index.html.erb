<h1 class="text-2xl font-bold mb-6">Categories</h1>

<div class="overflow-x-auto">
  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="border-b">
        <th class="p-3">Category Name</th>
        <th class="p-3">Parent Category</th>
        <th class="p-3">No. of Products</th>
      </tr>
    </thead>

    <tbody>
      <% @categories.each do |category| %>
        <tr class="border-b">
          <td class="p-3"><%= link_to category.name, category_books_path(category), class: "text-blue-600 hover:underline" %></td>
          <td class="p-3"><%= category.parent&.name || "N/A" %></td>
          <td class="p-3"><%= category.products_count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
