<div class="mx-auto md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-lg inline-block" id="notice">
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-600 font-medium rounded-lg inline-block" id="alert">
      <%= alert %>
    </p>
  <% end %>

  <%= form_tag login_path do %>
    <h2 class="font-bold text-3xl mb-6">Please Log In</h2>

    <div class="my-5">
      <%= label_tag :name, "Name:", class: "block font-medium mb-2" %>
      <%= text_field_tag :name, params[:name],
          class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= label_tag :password, "Password:", class: "block font-medium mb-2" %>
      <%= password_field_tag :password, nil,
          class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= submit_tag "Login",
          class: "rounded-lg py-3 px-5 bg-green-600 text-white font-medium cursor-pointer hover:bg-green-700" %>
    </div>
  <% end %>
</div>